# Discord Developer Portal'dan alacağın bot token
DISCORD_TOKEN=

# MongoDB Atlas connection string (mongodb+srv://... ile başlar)
MONGODB_URI=

# Rastgele, uzun ve kimsenin bilmediği bir metin yaz (session güvenliği için)
SESSION_SECRET=

# İlk admin hesabını oluştururken /setup sayfasında istenecek anahtar
# Rastgele bir şey yaz, kimseyle paylaşma
SETUP_KEY=

# Railway sana otomatik bir domain verecek, deploy sonrası buraya onu yaz
# örn: https://senin-projen.up.railway.app
DASHBOARD_URL=

# Railway PORT değişkenini otomatik verir, elle dokunmana gerek yok
PORT=3000
