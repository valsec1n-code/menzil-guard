<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Genel Bakış - Guard Bot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('partials/nav', { active }) %>
    <div class="content">
      <h1><%= guild ? guild.name : 'Sunucu bulunamadı' %></h1>
      <div class="subtitle">Genel bakış ve son olaylar</div>

      <div class="stat-row">
        <div class="stat-box">
          <div class="num"><%= guild ? guild.memberCount : '-' %></div>
          <div class="label">Toplam Üye</div>
        </div>
        <div class="stat-box">
          <div class="num"><%= totalBlocked %></div>
          <div class="label">Toplam Engellenen Olay</div>
        </div>
        <div class="stat-box">
          <div class="num"><%= config.channelGuard.deleteEnabled && config.antiRaid.enabled && config.antiSpam.enabled ? 'Aktif' : 'Kısmi' %></div>
          <div class="label">Koruma Durumu</div>
        </div>
      </div>

      <div class="card">
        <h3>Son 7 Gün - Engellenen Olaylar</h3>
        <% const maxCount = Math.max(1, ...dailyStats.map(d => d.count)); %>
        <div style="display:flex; align-items:flex-end; gap:10px; height:120px; margin-top:10px;">
          <% dailyStats.forEach(d => { %>
            <div style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%;">
              <div style="font-size:11px; color:#9aa0ac; margin-bottom:4px;"><%= d.count %></div>
              <div style="width:100%; background:#5865F2; border-radius:4px 4px 0 0; height:<%= (d.count / maxCount) * 90 %>px; min-height:2px;"></div>
              <div style="font-size:10px; color:#9aa0ac; margin-top:4px;"><%= d._id.slice(5) %></div>
            </div>
          <% }) %>
          <% if (dailyStats.length === 0) { %><p style="color:#9aa0ac; font-size:13px;">Son 7 günde kayıt yok.</p><% } %>
        </div>
      </div>

      <div class="card">
        <h3>Son 50 Log Kaydı</h3>
        <table>
          <tr><th>Tarih</th><th>Tip</th><th>Açıklama</th><th>Kişi</th><th>Ceza</th></tr>
          <% logs.forEach(log => { %>
            <tr>
              <td><%= new Date(log.createdAt).toLocaleString('tr-TR') %></td>
              <td><span class="tag"><%= log.type %></span></td>
              <td><%= log.description %></td>
              <td><%= log.moderatorTag || '-' %></td>
              <td><%= log.actionTaken || '-' %></td>
            </tr>
          <% }) %>
          <% if (logs.length === 0) { %>
            <tr><td colspan="5" style="color:#9aa0ac;">Henüz kayıt yok.</td></tr>
          <% } %>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
