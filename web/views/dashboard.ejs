<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Genel Bakış - Guard Bot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('partials/nav', { active }) %>
    <div class="content">
      <h1><%= guild ? guild.name : 'Sunucu bulunamadı' %></h1>
      <div class="subtitle">Genel bakış ve son olaylar</div>

      <div class="stat-row">
        <div class="stat-box">
          <div class="num"><%= guild ? guild.memberCount : '-' %></div>
          <div class="label">Toplam Üye</div>
        </div>
        <div class="stat-box">
          <div class="num"><%= totalBlocked %></div>
          <div class="label">Toplam Engellenen Olay</div>
        </div>
        <div class="stat-box">
          <div class="num"><%= config.antiNuke.enabled && config.antiRaid.enabled && config.antiSpam.enabled ? 'Aktif' : 'Kısmi' %></div>
          <div class="label">Koruma Durumu</div>
        </div>
      </div>

      <div class="card">
        <h3>Son 50 Log Kaydı</h3>
        <table>
          <tr><th>Tarih</th><th>Tip</th><th>Açıklama</th><th>Kişi</th><th>Ceza</th></tr>
          <% logs.forEach(log => { %>
            <tr>
              <td><%= new Date(log.createdAt).toLocaleString('tr-TR') %></td>
              <td><span class="tag"><%= log.type %></span></td>
              <td><%= log.description %></td>
              <td><%= log.moderatorTag || '-' %></td>
              <td><%= log.actionTaken || '-' %></td>
            </tr>
          <% }) %>
          <% if (logs.length === 0) { %>
            <tr><td colspan="5" style="color:#9aa0ac;">Henüz kayıt yok.</td></tr>
          <% } %>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
