<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>2FA Doğrulama</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-box">
      <h1>🔐 İki Adımlı Doğrulama</h1>
      <p style="font-size:13px;color:#9aa0ac;margin-bottom:16px;">Authenticator uygulamandaki 6 haneli kodu gir.</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="/login/2fa">
        <label>Doğrulama Kodu</label>
        <input type="text" name="code" maxlength="6" pattern="[0-9]{6}" required autofocus>
        <button type="submit" style="width:100%">Doğrula</button>
      </form>
    </div>
  </div>
</body>
</html>
