<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Şifre Sıfırla</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-box" style="width:360px;">
      <h1>🔄 Şifre Sıfırla</h1>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <% if (success) { %>
        <div class="success">✅ Şifre değiştirildi. Artık <a href="/login" style="color:#5865F2;">giriş yapabilirsin</a>.</div>
      <% } else { %>
        <form method="POST" action="/setup/reset-password">
          <label>Kurulum Anahtarı (.env - SETUP_KEY)</label>
          <input type="password" name="setupKey" required>
          <label>Kullanıcı Adı</label>
          <input type="text" name="username" required>
          <label>Yeni Şifre</label>
          <input type="password" name="newPassword" required minlength="6">
          <button type="submit" style="width:100%">Şifreyi Sıfırla</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>
