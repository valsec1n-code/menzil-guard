<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Hesabım</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('partials/nav', { active }) %>
    <div class="content">
      <h1>👤 Hesabım</h1>
      <div class="subtitle">Giriş yapan: <b><%= user.username %></b> (<%= user.role %>)</div>
      <% if (saved) { %><div class="success">✅ Kaydedildi.</div><% } %>
      <% if (error) { %><div class="error"><%= error %></div><% } %>

      <div class="card">
        <h3>🔑 Şifre Değiştir</h3>
        <form method="POST" action="/dashboard/account/password">
          <label>Mevcut Şifre</label>
          <input type="password" name="currentPassword" required>
          <label>Yeni Şifre</label>
          <input type="password" name="newPassword" required minlength="6">
          <button type="submit">Şifreyi Güncelle</button>
        </form>
      </div>

      <div class="card">
        <h3>🔐 İki Adımlı Doğrulama (2FA)</h3>
        <% if (user.twoFactorEnabled) { %>
          <div class="desc" style="color:#57f287;">✅ 2FA aktif, hesabın ekstra korumalı.</div>
          <form method="POST" action="/dashboard/account/2fa/disable">
            <button type="submit" class="btn-danger">2FA'yı Kapat</button>
          </form>
        <% } else if (qr) { %>
          <div class="desc">Google Authenticator / Authy gibi bir uygulamayla bu kodu tara, sonra uygulamadaki 6 haneli kodu gir.</div>
          <img src="<%= qr %>" style="background:#fff; padding:10px; border-radius:8px; margin-bottom:14px;">
          <form method="POST" action="/dashboard/account/2fa/confirm">
            <label>Doğrulama Kodu</label>
            <input type="text" name="code" maxlength="6" required>
            <button type="submit">Onayla ve Aktifleştir</button>
          </form>
        <% } else { %>
          <div class="desc">Panel hesabına ekstra güvenlik katmanı ekle (Google Authenticator vb. ile).</div>
          <form method="POST" action="/dashboard/account/2fa/start">
            <button type="submit">2FA'yı Kur</button>
          </form>
        <% } %>
      </div>

      <% if (user.role === 'owner') { %>
      <div class="card">
        <h3>➕ Yeni Panel Kullanıcısı Ekle</h3>
        <div class="desc">Güvendiğin bir kişiye de panel erişimi verebilirsin.</div>
        <form method="POST" action="/dashboard/account/add-admin">
          <label>Kullanıcı Adı</label>
          <input type="text" name="username" required>
          <label>Şifre</label>
          <input type="password" name="password" required minlength="6">
          <button type="submit">Ekle</button>
        </form>
      </div>

      <div class="card">
        <h3>👥 Mevcut Panel Kullanıcıları</h3>
        <% if (otherAdmins.length === 0) { %>
          <p style="color:#9aa0ac; font-size:13px;">Senin dışında başka panel kullanıcısı yok.</p>
        <% } else { %>
          <% otherAdmins.forEach(a => { %>
            <div class="list-item">
              <span><%= a.username %> <span class="tag"><%= a.role %></span></span>
              <form method="POST" action="/dashboard/account/delete-admin" onsubmit="return confirm('<%= a.username %> kullanıcısını silmek istediğine emin misin?');">
                <input type="hidden" name="userId" value="<%= a._id %>">
                <button type="submit" class="btn-danger">Sil</button>
              </form>
            </div>
          <% }) %>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</body>
</html>
